{
  "_doc": "P1 golden cases (WP-27). `cargo xtask pch-gates goldens` runs every case under the pinned pre-commit-hooks venvs of each golden tag and writes goldens/<tag>.json; tests/p1 replays them natively. Byte strings are latin-1 JSON strings (one char per byte). Steps: [w, path, bytes] write; [x, path] chmod 755; [ro, path] chmod 444; [mkdir, path]; [git, args...]; [gitfile, name, bytes] write under .git; [ln, target, path] symlink; [rm, path] remove a file or link; [home, path, bytes] write under $HOME. `env` adds variables to the hook's environment. A `partition` runs pre-commit's shuffle + xargs.partition (jobs, max length 131072) over its files, appending each partition to argv. `files` lists the paths whose bytes are compared (default: the written ones). `divergence` names a register ID under which the native intentionally differs (the case is replayed only by its dedicated test).",
  "tags": ["v3.0.0", "v3.3.0", "v3.4.0", "v4.0.1", "v4.2.0", "v4.3.0", "v4.5.0", "v4.6.0", "v5.0.0", "v6.0.0"],
  "cases": [
    {"name": "pfj-default-diff", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"b\":1,\"a\":[1,2,{}],\"c\":\"\u00c3\u00a9\"}"], ["w", "ok.json", "{\n  \"a\": 1\n}\n"]],
     "argv": ["a.json", "ok.json"]},
    {"name": "pfj-autofix", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"b\": 1, \"a\": 2}"], ["w", "b.json", "[1,2.50,1E5,-0,1e400]"]],
     "argv": ["--autofix", "a.json", "b.json"]},
    {"name": "pfj-crlf-pretty-passes", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\r\n  \"a\": 1\r\n}\r\n"]], "argv": ["a.json"]},
    {"name": "pfj-invalid-then-valid", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "bad.json", "{\"a\": }"], ["w", "b.json", "{\"z\":1}"]], "argv": ["bad.json", "b.json"]},
    {"name": "pfj-messages-after-diffs", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "[1]"], ["w", "bad.json", "nope"], ["w", "c.json", "{\"x\":[]}"]],
     "argv": ["a.json", "bad.json", "c.json"]},
    {"name": "pfj-indent-options", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"a\":[1,{\"b\":2}]}"], ["w", "b.json", "{\"a\":[1,{\"b\":2}]}"], ["w", "c.json", "{\"a\":[1,{\"b\":2}]}"]],
     "argv": ["--indent=4", "a.json", "--indent", "\t", "b.json", "--indent=-2", "c.json"]},
    {"name": "pfj-indent-4", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"a\":[1,{\"b\":2}]}"]], "argv": ["--indent=4", "a.json"]},
    {"name": "pfj-indent-tab", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"a\":[1,{\"b\":2}]}"]], "argv": ["--indent", "\t", "--autofix", "a.json"]},
    {"name": "pfj-indent-negative-and-empty", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"a\":[1,{\"b\":2}]}"], ["w", "b.json", "{\"a\":[1,{\"b\":2}]}"]], "argv": ["--indent=-2", "--autofix", "a.json", "--indent=", "b.json"]},
    {"name": "pfj-indent-string", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"a\":[1]}"]], "argv": ["--indent= 0x", "--autofix", "a.json"]},
    {"name": "pfj-no-ensure-ascii", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "b.json", "[\"\u00c3\u00a9\", \"\\u2028\", \"\\u0001\", \"\\u007f\"]"]], "argv": ["--no-ensure-ascii", "--autofix", "b.json"]},
    {"name": "pfj-no-ensure-ascii-surrogate", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "[\"x\", \"\\ud800\"]"], ["w", "b.json", "[2]"]], "argv": ["--no-ensure-ascii", "a.json", "b.json"]},
    {"name": "pfj-no-ensure-ascii-surrogate-autofix", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "[\"x\", \"\\ud800\\udfff\\ud801\"]"], ["w", "b.json", "[2]"]], "argv": ["--no-ensure-ascii", "--autofix", "a.json", "b.json"]},
    {"name": "pfj-top-keys-no-sort", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"z\":1,\"b\":{\"y\":1,\"id\":2},\"id\":3,\"name\":4}"]],
     "argv": ["--top-keys=name,id", "--no-sort-keys", "--autofix", "a.json"]},
    {"name": "pfj-ensure-ascii", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "[\"\u00c3\u00a9\", \"\u00f0\u009f\u0098\u0080\", \"\\u007f\", \"\\ud800\"]"], ["w", "b.json", "[\"\u00c3\u00a9\", \"\\u2028\"]"]],
     "argv": ["--autofix", "a.json", "--no-ensure-ascii", "b.json"]},
    {"name": "pfj-duplicate-keys", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"a\": 1, \"a\": 2, \"x\": 1, \"x\": 0}"], ["w", "b.json", "{\"a\": 1, \"a\": {}}"], ["w", "c.json", "[]"]],
     "argv": ["--autofix", "a.json", "b.json", "c.json"]},
    {"name": "pfj-bom-invalid", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "\u00ef\u00bb\u00bf{}"]], "argv": ["a.json"]},
    {"name": "pfj-not-utf8-crash", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "[1]"], ["w", "b.json", "[\"\u00ff\"]"], ["w", "c.json", "[2]"]], "argv": ["--autofix", "a.json", "b.json", "c.json"]},
    {"name": "pfj-big-diff", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "[{\"k\":0,\"v\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"k\":1,\"v\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"k\":2,\"v\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]"], ["w", "bad.json", "["]],
     "argv": ["bad.json", "a.json", "bad.json"]},
    {"name": "pfj-partial-diff", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\n  \"a\": 1,\n  \"b\": 2,\n  \"c\": 3,\n  \"d\": 4,\n  \"e\": 5,\n  \"f\": 6,\n    \"g\": 7,\n  \"h\": 8\n}"]],
     "argv": ["a.json"]},
    {"name": "pfj-flag-file", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "-x.json", "{}"], ["w", "a.json", "{}"]], "argv": ["a.json", "-x.json"]},
    {"name": "pfj-abbrev-autofix", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "[ ]"]], "argv": ["--auto", "a.json"]},
    {"name": "pfj-missing-crash", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"b\":1}"]], "argv": ["a.json", "nope.json", "a.json"]},
    {"name": "pfj-type-error-crash", "script": "pretty-format-json", "hook": "pretty-format-json",
     "steps": [["w", "a.json", "{\"a\": 1, \"a\": \"x\"}"], ["w", "b.json", "[1]"]], "argv": ["a.json", "b.json"]},

    {"name": "fcs-table", "script": "file-contents-sorter", "hook": "file-contents-sorter",
     "steps": [["w", "a", "b\r\nA\n\n  \nc \na\nB"], ["w", "b", "a\rc\rb\r"], ["w", "c", ""], ["w", "d", "\n\n"], ["w", "e", "a\nb\n"], ["w", "f", "\rz\r\ny\n"]],
     "argv": ["a", "b", "c", "d", "e", "f"]},
    {"name": "fcs-ignore-case", "script": "file-contents-sorter", "hook": "file-contents-sorter",
     "steps": [["w", "a", "b\nB\nA\na\n\u00c9\n\u00e9\n"]], "argv": ["--ignore-case", "a"]},
    {"name": "fcs-unique", "script": "file-contents-sorter", "hook": "file-contents-sorter",
     "steps": [["w", "a", "b\nb\r\nA\na\na \n"]], "argv": ["--unique", "a"]},
    {"name": "fcs-both-flags", "script": "file-contents-sorter", "hook": "file-contents-sorter",
     "steps": [["w", "a", "b\nc\nb\n"]], "argv": ["--unique", "--ignore-case", "a"]},
    {"name": "fcs-no-files", "script": "file-contents-sorter", "hook": "file-contents-sorter",
     "steps": [], "argv": []},
    {"name": "fcs-missing-crash", "script": "file-contents-sorter", "hook": "file-contents-sorter",
     "steps": [["w", "a", "b\na\n"], ["w", "c", "d\nc\n"]], "argv": ["a", "nope", "c"]},
    {"name": "fcs-directory-crash", "script": "file-contents-sorter", "hook": "file-contents-sorter",
     "steps": [["mkdir", "d"], ["w", "a", "b\na\n"]], "argv": ["d", "a"]},
    {"name": "fcs-readonly-sorted", "script": "file-contents-sorter", "hook": "file-contents-sorter", "posix": true, "divergence": "D-CRASH-23",
     "steps": [["w", "ro", "a\nb\n"], ["ro", "ro"], ["w", "c", "d\nc\n"]], "argv": ["ro", "c"]},
    {"name": "fcs-partitions", "script": "file-contents-sorter", "hook": "file-contents-sorter",
     "steps": [["w", "f1", "b\na\n"], ["w", "f2", "a\n"], ["w", "f3", "z\ny\n"], ["w", "f4", "1\n"], ["w", "f5", "q\np\n"], ["w", "f6", "\n"], ["w", "f7", "x"], ["w", "f8", "m\nm\n"], ["w", "f9", "k\nj\n"]],
     "argv": [], "partition": {"jobs": 2, "files": ["f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9"]}},

    {"name": "rtf-big", "script": "requirements-txt-fixer", "hook": "requirements-txt-fixer",
     "steps": [["w", "requirements.txt", "# top comment\n\nzope==1\n# about flask\nFlask>=2  # x\nflask==1\nDjango[bcrypt]~=4\npkg-resources==0.0.0\nrequests @ https://x/r.zip\n-e git+https://g/x.git#egg=Alpha\nnumpy; python_version>\"3\"\nfoo \\\n  --hash=sha256:abc\nbar\n# trailing\n"]],
     "argv": ["requirements.txt"]},
    {"name": "rtf-table", "script": "requirements-txt-fixer", "hook": "requirements-txt-fixer",
     "steps": [["w", "r1", "a==1\nb\na==1\n# c\nb\n"], ["w", "r2", "\nb\na\n"], ["w", "r3", "# c1\n# c2\nb\n\na\n"], ["w", "r4", "# hdr\n# hdr2\n\n# for z\nz\n\na\n# trailing\n\n"], ["w", "r5", "a \\\n\n  --hash=x\nB\n"], ["w", "r6", "b\r\npkg-resources==0.0.0\r\na\r\n"], ["w", "r7", "x"], ["w", "r8", " \n\t\n"], ["w", "r9", "b\npkg_resources==0.0.0\na\n"], ["w", "r10", "b\n  # indented\na\n"], ["w", "r11", "B==1\nb==1\n# z\nb==1\n"], ["w", "r12", "a!=1\nA~=2\na<3\na>=1\na===2\nab=1\n"]],
     "argv": ["r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12"]},
    {"name": "rtf-indented-crash", "script": "requirements-txt-fixer", "hook": "requirements-txt-fixer",
     "steps": [["w", "a.txt", "b\na\n"], ["w", "r.txt", "b\n  flask==1\n"], ["w", "z.txt", "z\ny\n"]], "argv": ["a.txt", "r.txt", "z.txt"]},
    {"name": "rtf-single-indented-passes", "script": "requirements-txt-fixer", "hook": "requirements-txt-fixer",
     "steps": [["w", "r.txt", "  flask==1\n"], ["w", "s.txt", "# h\n\n;x\n"]], "argv": ["r.txt", "s.txt"]},
    {"name": "rtf-egg-case", "script": "requirements-txt-fixer", "hook": "requirements-txt-fixer",
     "steps": [["w", "r.txt", "zz\n-e git+x#EGG=Beta\nhttps://h/a.zip#egg=aa&egg=zz\n-e y&egg=Alpha\n"]], "argv": ["r.txt"]},
    {"name": "rtf-help", "script": "requirements-txt-fixer", "hook": "requirements-txt-fixer",
     "steps": [["w", "r.txt", "b\na\n"]], "argv": ["r.txt", "-h"]},

    {"name": "ccc-staged", "script": "check-case-conflict", "hook": "check-case-conflict",
     "steps": [["w", "Dir/x", "1"], ["w", "README", "r"], ["git", "add", "."], ["git", "commit", "-qm", "init"], ["w", "readme", "r"], ["w", "dir/y", "y"], ["w", "new/A.txt", "a"], ["w", "new/a.txt", "a"], ["w", "NEW/b", "b"], ["git", "add", "."]],
     "argv": ["readme"], "files": []},
    {"name": "ccc-no-conflict", "script": "check-case-conflict", "hook": "check-case-conflict",
     "steps": [["w", "a", "1"], ["git", "add", "."], ["git", "commit", "-qm", "init"], ["w", "b", "b"], ["git", "add", "b"]],
     "argv": ["b"], "files": []},
    {"name": "ccc-passed-file-only", "script": "check-case-conflict", "hook": "check-case-conflict",
     "steps": [["w", "Foo.txt", "1"], ["git", "add", "."], ["git", "commit", "-qm", "init"]],
     "argv": ["foo.txt", "Bar", "bar"], "files": []},
    {"name": "ccc-non-ascii-invisible", "script": "check-case-conflict", "hook": "check-case-conflict",
     "steps": [["w", "\u00c3\u0084.txt", "1"], ["git", "add", "."], ["git", "commit", "-qm", "init"], ["w", "\u00c3\u00a4.txt", "2"], ["git", "add", "."]],
     "argv": ["\u00e4.txt"], "files": []},
    {"name": "ccc-quotepath-false", "script": "check-case-conflict", "hook": "check-case-conflict",
     "steps": [["git", "config", "core.quotePath", "false"], ["w", "\u00c3\u0084.txt", "1"], ["git", "add", "."], ["git", "commit", "-qm", "init"], ["w", "\u00c3\u00a4.txt", "2"], ["git", "add", "."]],
     "argv": [], "files": []},
    {"name": "ccc-partitions", "script": "check-case-conflict", "hook": "check-case-conflict",
     "steps": [["w", "f1", "1"], ["w", "f2", "2"], ["w", "f3", "3"], ["w", "f4", "4"], ["w", "f5", "5"], ["w", "f6", "6"], ["w", "F7", "7"], ["w", "f7", "7"], ["git", "add", "."]],
     "argv": [], "partition": {"jobs": 3, "files": ["f1", "f2", "f3", "f4", "f5", "f6", "F7", "f7"]}, "files": []},
    {"name": "ccc-flag-file", "script": "check-case-conflict", "hook": "check-case-conflict",
     "steps": [], "argv": ["-x"], "files": []},

    {"name": "sse-table", "script": "check-shebang-scripts-are-executable", "hook": "check-shebang-scripts-are-executable",
     "steps": [["w", "a.sh", "#!/bin/sh\n"], ["w", "b.sh", "#!/bin/sh\n"], ["x", "b.sh"], ["w", "c.txt", "plain\n"], ["w", "it's.sh", "#!x\n"], ["w", "untracked.sh", "#!/bin/sh\n"], ["git", "add", "a.sh", "b.sh", "c.txt", "it's.sh"]],
     "argv": ["a.sh", "b.sh", "c.txt", "it's.sh", "untracked.sh"], "files": []},
    {"name": "sse-glob-pathspec", "script": "check-shebang-scripts-are-executable", "hook": "check-shebang-scripts-are-executable",
     "steps": [["w", "a1.sh", "#!/bin/sh\n"], ["w", "a2.sh", "#!/bin/sh\n"], ["git", "add", "."]],
     "argv": ["a?.sh"], "files": []},
    {"name": "sse-deleted-crash", "script": "check-shebang-scripts-are-executable", "hook": "check-shebang-scripts-are-executable",
     "steps": [["w", "a.sh", "#!/bin/sh\n"], ["w", "b.sh", "#!/bin/sh\n"], ["git", "add", "."], ["rm", "b.sh"]],
     "argv": ["a.sh", "b.sh"], "files": []},

    {"name": "csl-table", "script": "check-symlinks", "hook": "check-symlinks", "posix": true,
     "steps": [["w", "t", "x"], ["ln", "t", "good"], ["ln", "missing", "bad"], ["ln", "loop2", "loop1"], ["ln", "loop1", "loop2"]],
     "argv": ["good", "bad", "loop1", "t", "nope"], "files": []},

    {"name": "dsl-destroyed", "script": "destroyed-symlinks", "hook": "destroyed-symlinks", "posix": true,
     "steps": [["w", "target", "x"], ["ln", "target", "link"], ["ln", "target", "link two"], ["ln", "target", "ok"], ["ln", "target", "changed"], ["git", "add", "."], ["git", "commit", "-qm", "init"], ["rm", "link"], ["w", "link", "target"], ["rm", "link two"], ["w", "link two", "target\r\n"], ["rm", "changed"], ["w", "changed", "other"], ["git", "add", "."]],
     "argv": ["link", "link two", "ok", "changed", "target"], "files": []},
    {"name": "dsl-none", "script": "destroyed-symlinks", "hook": "destroyed-symlinks",
     "steps": [["w", "a", "x"], ["git", "add", "."], ["git", "commit", "-qm", "init"]],
     "argv": ["a"], "files": []},
    {"name": "dsl-no-files", "script": "destroyed-symlinks", "hook": "destroyed-symlinks",
     "steps": [], "argv": [], "files": []},

    {"name": "cbom-table", "script": "check-byte-order-marker", "hook": "check-byte-order-marker",
     "steps": [["w", "a", "\u00ef\u00bb\u00bfx"], ["w", "b", "x"], ["w", "c", "\u00ef\u00bb"]], "argv": ["a", "b", "c"]},
    {"name": "cbom-missing-crash", "script": "check-byte-order-marker", "hook": "check-byte-order-marker",
     "steps": [["w", "a", "\u00ef\u00bb\u00bfx"], ["w", "c", "\u00ef\u00bb\u00bfx"]], "argv": ["a", "nope", "c"]}
  ]
}
