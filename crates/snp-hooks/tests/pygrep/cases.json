{
  "_doc": "pygrep golden cases (WP-26): `cargo xtask pch-goldens pygrep` runs `python -m pre_commit.languages.pygrep *argv` (pre-commit 4.6.2, CPython 3.13) in a fresh directory per case and writes goldens.json; tests/pygrep replays them with snp_hooks::pygrep. Steps and byte strings as in tests/p0/cases.json. `args` + [`entry`] is what `prepare` sees; argv = args + [entry] + files.",
  "fixtures": {
    "a.txt": "hello TODO world\nfoo\nbar baz\n",
    "c.txt": "line1\r\nTODO crlf\r\n",
    "multi.txt": "x foo foo\ny\nfoo",
    "crlf.txt": "a\r\nfoo bar\r\nbaz\r\n",
    "cr2.txt": "foo\r\r\n",
    "d.txt": "abc\ndef\nghi",
    "nl.txt": "ab\ncd\n",
    "b.txt": "nothing here\n",
    "empty.txt": "",
    "u.bin": "caf\u00c3\u00a9 x",
    "U.bin": "CAF\u00c3\u0089",
    "bin.dat": "a\u00ffb\n\u0000\u00fe\n",
    "last.txt": "first\nlast line no newline",
    "-i": "foo in a file named -i\n",
    "--negate": "foo\n",
    "-x.py": "foo\n",
    "py.py": "import os  # noqa\nx = 1  # noqa: F401\ny = eval('1')\nlog.warn('x')\nwarnings.warn('y')\nz = 1  # type: int\nw = 2  # type: ignore\nv = 3  # type: ignore[attr]\nm.assert_called_once()\nassert m.not_called()\nMock.assert_called\nm.assert_has_calls(x)\n",
    "doc.rst": "Use `code` here\n    `indented` ok\n.. note:\n.. warning ::\n.. tip::\nx``y\nreplacement \u00ef\u00bf\u00bd char\n"
  },
  "cases": [
    {"name": "todo", "args": [], "entry": "TODO", "files": ["a.txt", "c.txt"]},
    {"name": "foo-multi", "args": [], "entry": "foo", "files": ["multi.txt"]},
    {"name": "ignore-case", "args": ["-i"], "entry": "FOO", "files": ["multi.txt", "crlf.txt"]},
    {"name": "dollar-line", "args": [], "entry": "foo$", "files": ["a.txt", "cr2.txt", "multi.txt"]},
    {"name": "ml-def-ghi", "args": ["--multiline"], "entry": "def\nghi", "files": ["d.txt"]},
    {"name": "ml-dotall", "args": ["--multiline"], "entry": "foo.*\n", "files": ["crlf.txt"]},
    {"name": "ml-leading-nl", "args": ["--multiline"], "entry": "\ncd", "files": ["nl.txt"]},
    {"name": "ml-caret", "args": ["--multiline"], "entry": "^", "files": ["d.txt"]},
    {"name": "ml-dollar", "args": ["--multiline"], "entry": "foo$", "files": ["multi.txt"]},
    {"name": "ml-dollar-scoped-off", "args": ["--multiline"], "entry": "(?-m:foo$)", "files": ["multi.txt"]},
    {"name": "negate", "args": ["--negate"], "entry": "foo", "files": ["b.txt", "multi.txt", "empty.txt"]},
    {"name": "negate-empty", "args": ["--negate"], "entry": "x", "files": ["empty.txt"]},
    {"name": "negate-ml-empty", "args": ["--negate", "--multiline"], "entry": "x", "files": ["empty.txt", "d.txt"]},
    {"name": "ascii-w", "args": [], "entry": "caf\\w", "files": ["u.bin"]},
    {"name": "utf8-literal", "args": [], "entry": "caf\u00e9", "files": ["u.bin"]},
    {"name": "ascii-fold", "args": ["-i"], "entry": "caf\u00e9", "files": ["U.bin"]},
    {"name": "binary-bytes", "args": [], "entry": "\\xff|\\x00", "files": ["bin.dat"]},
    {"name": "last-line", "args": [], "entry": "line no", "files": ["last.txt"]},
    {"name": "empty-all-modes", "args": [], "entry": "x", "files": ["empty.txt"]},
    {"name": "empty-ml", "args": ["--multiline"], "entry": "", "files": ["empty.txt"]},
