    {"name": "invalid-overflow", "args": [], "entry": "a{4294967295}", "files": ["a.txt"]},
    {"name": "invalid-lookbehind", "args": [], "entry": "(?<=a|bc)x", "files": ["a.txt"]},
    {"name": "invalid-ascii-locale", "args": [], "entry": "(?a)(?L)x", "files": ["a.txt"]},
    {"name": "invalid-multiline-pos", "args": [], "entry": "a\n(", "files": ["a.txt"]},
    {"name": "missing-file", "args": [], "entry": "TODO", "files": ["a.txt", "nope.txt", "c.txt"]},
    {"name": "directory", "args": [], "entry": "TODO", "files": ["a.txt", "."]},
    {"name": "pgh-blanket-noqa", "args": [], "entry": "(?i)# noqa(?!: )", "files": ["py.py"]},
    {"name": "pgh-blanket-type-ignore", "args": [], "entry": "# type:? *ignore(?!\\[|\\w)", "files": ["py.py"]},
    {"name": "pgh-mock-methods", "args": [], "entry": "(?x)(\n    assert .*\\.(\n        not_called|\n        called_\n    )|\n    # ''.join(rf'(?<!\\b{s})' for s in dir(mock) if s.endswith('Mock')))\n    (?<!\\bAsyncMock)(?<!\\bMagicMock)(?<!\\bMock)(?<!\\bNonCallableMagicMock)(?<!\\bNonCallableMock)(?<!\\bPropertyMock)\n    \\.assert_(\n        any_call|\n        called|\n        called_once|\n        called_once_with|\n        called_with|\n        has_calls|\n        not_called\n    )($|[^(\\w])\n)\n", "files": ["py.py"]},
    {"name": "pgh-no-eval", "args": [], "entry": "\\beval\\(", "files": ["py.py"]},
    {"name": "pgh-no-log-warn", "args": [], "entry": "(?<!warnings)\\.warn\\(", "files": ["py.py"]},
    {"name": "pgh-type-annotations", "args": [], "entry": "# type(?!: *ignore([^a-zA-Z0-9]|$))", "files": ["py.py"]},
    {"name": "pgh-rst-backticks", "args": [], "entry": "^(?!    ).*(^| )`[^`]+`([^_]|$)", "files": ["doc.rst"]},
    {"name": "pgh-rst-directive-colons", "args": [], "entry": "^\\s*\\.\\. [a-z]+(| | :):$", "files": ["doc.rst"]},
    {"name": "pgh-rst-inline-touching", "args": [], "entry": "\\w``\\w", "files": ["doc.rst"]},
    {"name": "pgh-replacement-char", "args": [], "entry": "\ufffd", "files": ["doc.rst", "py.py"]},
    {"name": "entry-flag-i", "args": [], "entry": "-i", "files": ["todo", "a.txt", "c.txt"]},
    {"name": "entry-flag-negate", "args": [], "entry": "--negate", "files": ["TODO", "a.txt", "b.txt", "c.txt"]},
    {"name": "entry-flag-unknown", "args": [], "entry": "-foo", "files": ["a.txt"]},
